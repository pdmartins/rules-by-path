#!/bin/sh
# rules-by-path PreToolUse hook launcher. Exits 0 even when Python is missing:
# a hook must never block a tool call, and a non-zero exit on every Read would
# make the plugin unusable instead of merely inactive.
SELF=$0
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF")
    case $LINK in /*) SELF=$LINK ;; *) SELF=$(dirname -- "$SELF")/$LINK ;; esac
done
DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")/.." && pwd) || exit 0
for PY in python3 python; do
    if command -v "$PY" >/dev/null 2>&1; then
        exec "$PY" "$DIR/hooks/rules-by-path.py" "$@"
    fi
done
echo "rules-by-path: no python3/python on PATH; rules are not being injected" >&2
exit 0
