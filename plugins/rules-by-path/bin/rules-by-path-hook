#!/bin/sh
# rules-by-path PreToolUse hook launcher. ALWAYS exits 0: a hook must never block
# a tool call, and a non-zero exit on every Read would make the plugin unusable
# instead of merely inactive. Notably we do NOT `exec` the interpreter — if the
# hook script were missing or unreadable (a partial install, a moved file),
# `exec python missing.py` would exit 2, which Claude Code treats as a BLOCKING
# error. Running it and then forcing exit 0 degrades that to inactive instead.
SELF=$0
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF")
    case $LINK in /*) SELF=$LINK ;; *) SELF=$(dirname -- "$SELF")/$LINK ;; esac
done
DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")/.." && pwd) || exit 0
# See bin/rules-by-path for why `py` is in this list and why each candidate has
# to prove it runs before being used.
for PY in python3 python py; do
    command -v "$PY" >/dev/null 2>&1 || continue
    if [ "$PY" = "py" ]; then PYARGS="-3"; else PYARGS=""; fi
    "$PY" $PYARGS -c "" >/dev/null 2>&1 || continue
    "$PY" $PYARGS "$DIR/hooks/rules-by-path.py" "$@"
    exit 0
done
echo "rules-by-path: no working python3/python/py on PATH; rules are not being injected" >&2
exit 0
