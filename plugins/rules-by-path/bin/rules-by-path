#!/bin/sh
# rules-by-path admin CLI launcher. Resolves whichever Python is available so
# the plugin does not depend on a `python3` name that many installs lack.
SELF=$0
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF")
    case $LINK in /*) SELF=$LINK ;; *) SELF=$(dirname -- "$SELF")/$LINK ;; esac
done
DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")/.." && pwd) || exit 1
# `py` is the Windows launcher, and it belongs here rather than only in the .cmd
# files: on Windows the hook and the Bash tool both run through git-bash, so this
# script is what executes there and the .cmd is never reached. Each candidate is
# also asked to run a trivial program before it is trusted, because Windows ships
# App-Execution-Alias stubs named python3/python that satisfy `command -v` and
# then just open the Microsoft Store.
for PY in python3 python py; do
    command -v "$PY" >/dev/null 2>&1 || continue
    if [ "$PY" = "py" ]; then PYARGS="-3"; else PYARGS=""; fi
    "$PY" $PYARGS -c "" >/dev/null 2>&1 || continue
    exec "$PY" $PYARGS "$DIR/scripts/rules-by-path-admin.py" "$@"
done
echo "rules-by-path: no working python3/python/py found on PATH; install Python 3.8+" >&2
exit 1
